# config.py.example
# Exemple de configuration pour le backend
# Copiez ce fichier vers config.py et adaptez les valeurs à votre environnement

import os

# ── MODBUS ────────────────────────────────────────────────────────────────────
MODBUS_PORT      = '/dev/ttyUSB0'
MODBUS_BAUDRATE  = 9600
MODBUS_PARITY    = 'N'
MODBUS_STOPBITS  = 1
MODBUS_BYTESIZE  = 8
MODBUS_TIMEOUT   = 1       # seconds (reduit pour eviter timeouts en cascade sur le bus RS485)

# Addresses MODBUS des 6 capteurs de temperature
# Format: { (group_id, mold_id): (slave_address, register_address) }
# Heater 1 → 1 moule, Heater 2 → 2 moules, Heater 3 → 2 moules, Heater 4 → 1 moule
SENSOR_MAP = {
    (1, 1): (1, 0),   # Heater 1 — moule 1 (gauche)
    (2, 1): (2, 0),   # Heater 2 — moule 1 (gauche)
    (2, 2): (3, 0),   # Heater 2 — moule 2 (centre)
    (3, 1): (4, 0),   # Heater 3 — moule 1 (gauche)
    (3, 2): (5, 0),   # Heater 3 — moule 2 (centre)
    (4, 1): (7, 0),   # Heater 4 — moule 1 (gauche)
}

# Position labels per mold_id within a group
POSITION_MAP = {
    1: 'gauche',
    2: 'droite',
}

# Mold nomenclature for display in UI and alerts
MOLD_NOMENCLATURE = {
    (1, 1): 'RBA_178 #03',
    (2, 1): 'RBA_178 #01',
    (2, 2): 'RBA_178 #02',
    (3, 1): 'RBA_174 #02',
    (3, 2): 'RBA_174 #06',
    (4, 1): 'RBA_174 #08',
}

TEMP_SCALE_FACTOR = 0.1

# ── CALIBRATION OFFSETS ─────────────────────────────────────────────────────────
# Decalage logiciel par capteur pour corriger les ecarts systematiques.
# Format: (group_id, mold_id): offset_en_degres
CALIBRATION_OFFSETS = {
}

# ── TEMPERATURE THRESHOLDS ────────────────────────────────────────────────────
T_HEATER          = 45.0    # heater setpoint (degrees C)
T_TOLERANCE       = 3.0     # process tolerance (degrees C) — bande 42–48°C
T_MOLD_WARNING    = 42.0    # < 42 → ALERTE (warning)
T_MOLD_CRITICAL   = 40.0    # < 40 → CRITIQUE

# ── INFLUXDB ─────────────────────────────────────────────────────────────────
INFLUX_URL    = 'http://localhost:8086'
INFLUX_TOKEN  = 'YOUR_INFLUX_TOKEN_HERE'
INFLUX_ORG    = 'temperature-monitoring'
INFLUX_BUCKET  = 'sensors'
INFLUX_TIMEOUT = 120_000    # ms (2 min) — requis pour les grosses requêtes (60j)

# ── ALERTES — Telegram et Email (envoi direct) ───────────────────────────────
# Remplacer les valeurs par vos tokens Telegram et identifiants SMTP.
TELEGRAM_BOT_TOKEN    = os.getenv('TELEGRAM_BOT_TOKEN',    'YOUR_BOT_TOKEN')
TELEGRAM_OPERATORS_ID = os.getenv('TELEGRAM_OPERATORS_ID', 'YOUR_GROUP_ID')
TELEGRAM_CHEF_ID      = os.getenv('TELEGRAM_CHEF_ID',     'YOUR_CHEF_ID')

SMTP_HOST     = os.getenv('SMTP_HOST',     'smtp.gmail.com')
SMTP_PORT     = int(os.getenv('SMTP_PORT', '587'))
SMTP_USER     = os.getenv('SMTP_USER',     'YOUR_EMAIL@gmail.com')
SMTP_PASSWORD = os.getenv('SMTP_PASSWORD', 'YOUR_APP_PASSWORD')
EMAIL_FROM    = os.getenv('EMAIL_FROM',    'YOUR_EMAIL@gmail.com')
EMAIL_TO      = os.getenv('EMAIL_TO',      'chef.equipe@example.ma')

# ── FLOW SENSOR (YF-S201 Hall Effect, only on Heater 1) ───────────────────────
# Un seul debimetre installe sur le heater 1 (lie a un seul moule).
# Wiring: Red=5V, Black=GND, Yellow=Signal (GPIO)
# Formula: Flow Rate (L/min) = Frequency (Hz) / 7.5
FLOW_SENSOR_PINS = {
    1: 17,  # Heater 1 (seul heater avec debitmetre)
}
FLOW_DEFAULT_LPM     = 16.5       # Fallback if sensor fails
YF_S201_PULSE_FACTOR = 7.5        # Pulses per Liter/minute

# ── GREY-BOX PHYSICAL PARAMETERS ─────────────────────────────────────────────
PIPE_DIAMETER    = 0.013    # m  (13 mm)
PIPE_LENGTH      = 3.0      # m
LAMBDA_CALCAIRE  = 1.0      # W/(m.K)
N_MOLDS          = 6
RHO_WATER        = 1000.0   # kg/m3
CP_WATER         = 4186.0   # J/(kg.K)

# ── MACHINE LEARNING ──────────────────────────────────────────────────────────
FEATURE_WINDOW_SECONDS  = 30
RIDGE_MIN_DAYS          = 7
BOOTSTRAP_N             = 1000
RETRAIN_HOUR            = 5
FORCE_REAL_ONLY         = False                 # True apres seuil J (donnees reelles uniquement)

# ── WEBSOCKET ─────────────────────────────────────────────────────────────────
WS_HOST           = '0.0.0.0'
WS_PORT           = 8001

# ── ACQUISITION ───────────────────────────────────────────────────────────────
ACQUISITION_HZ = 1   # readings per second

# ── AMDEC (Analyse des Modes de Défaillance) ──────────────────────────────────
# Format: criticite = G × O × D (Gravite x Occurrence x Detection)
#
# NIVEAU_BAS_VANNE_PANNE:  G=9 (arrêt production), O=4, D=5
# HEATER_RESISTANCE_HS:    G=8 (perte chauffage), O=4, D=5
# CALCAIRE_TUYAUX:         G=8 (perte debit >20%), O=4, D=3
# HEATER_POMPE_HS:         G=9 (arrêt production), O=2, D=5
# BULLES_AIR:              G=6 (degradation 5-10%), O=5, D=3
# FUITE_CIRCUIT:           G=6 (perte fluide), O=5, D=2
# ISOLATION_DEGRADEE:      G=5 (perte rendement 3%), O=3, D=3

AMDEC_FAILURE_MODES = {
