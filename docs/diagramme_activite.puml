@startuml
start

:Acquisition données;
fork
  :Lecture capteurs température\n(Modbus RTU - 6 capteurs);
fork again
  :Lecture débitmètres\n(YF-S201 - GPIO);
endfork

:Construction SensorReadings;

if (Température OK ?) then (oui)
  :Statut = OK;
elseif (Température < 42°C ?) then (oui)
  :Statut = ALERTE;
else (critique)
  :Statut = CRITIQUE;
endif

:Calcul Grey-Box\n(delta_T_calcaire,\n epaisseur_mm);

:Extraction features\n(slope, variance,\n flow_rate, etc.);

:Prédiction Isolation Forest;

if (Anomalie détectée ?) then (oui)
  :Règles physiques N1\n(cause probable);
  if (Cause identifiée par\nrègles N1 ?) then (non)
    :Random Forest N2\n(10 features);
    :Cause + Confiance;
  else (oui)
    :Cause + Confiance;
  endif
  :Enrichissement AMDEC\n(criticite, actions);
  :Envoi alerte\n(Telegram + Email);
  :Ajout à l'historique\ndes diagnostics;
else (non)
  :Cause = NORMAL;
endif

:Écriture InfluxDB\n(temperature + flow);

:Broadcast WebSocket\n(sensors + diagnostic);

stop
@enduml
