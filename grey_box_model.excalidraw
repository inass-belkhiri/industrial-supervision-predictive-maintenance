    },
    {
      "id": "bottom_note",
      "type": "rectangle",
      "x": 40,
      "y": 440,
      "width": 920,
      "height": 85,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f0f0f0",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
