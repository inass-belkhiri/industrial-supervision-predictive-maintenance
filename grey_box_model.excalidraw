      "x": 180,
      "y": 15,
      "width": 700,
      "height": 35,
      "text": "Modèle Grey-Box — Estimation soft-sensor de l'épaisseur de calcaire",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "inputs_box",
      "type": "rectangle",
      "x": 40,
      "y": 80,
      "width": 220,
      "height": 320,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f0f0f0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100
    },
    {
      "id": "inputs_label",
      "type": "text",
      "x": 100,
      "y": 90,
      "width": 100,
      "height": 25,
      "text": "ENTRÉES",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "input_T_heater",
      "type": "text",
      "x": 50,
      "y": 125,
      "width": 200,
      "height": 20,
      "text": "T_heater = 45 °C  (consigne)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "input_T_mold",
      "type": "text",
      "x": 50,
      "y": 150,
      "width": 200,
      "height": 20,
      "text": "T_mold(t)  (température actuelle)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "input_T_calib",
      "type": "text",
      "x": 50,
      "y": 175,
      "width": 200,
      "height": 20,
      "text": "T_mold_jour1  (calibration J1)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "input_flow",
      "type": "text",
      "x": 50,
      "y": 200,
      "width": 200,
      "height": 40,
      "text": "débit (L/min) — réel pour G1/M1\nforfaitaire (16,5) pour les autres",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "input_constants",
      "type": "text",
      "x": 50,
      "y": 255,
      "width": 200,
      "height": 55,
      "text": "Constantes physiques :\nρ = 1000 kg/m³\nCp = 4186 J/(kg·K)\nλ_calcaire = 1,0 W/(m·K)\nD = 13 mm, L = 3 m",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "input_note",
      "type": "text",
      "x": 50,
      "y": 340,
      "width": 200,
      "height": 50,
      "text": "Sources :\nCapteurs Modbus RTU (température)\nDébitmètre YF-S201 (flux)\nCalibration stockée en mémoire",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#666666",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 80
    },
    {
      "id": "arrow_in",
      "type": "arrow",
      "x": 260,
      "y": 240,
      "width": 70,
      "height": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "startArrowhead": null,
      "endArrowhead": "triangle"
    },
    {
      "id": "greybox_box",
      "type": "rectangle",
      "x": 330,
      "y": 70,
      "width": 340,
      "height": 350,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#f0f0f0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100
    },
    {
      "id": "greybox_label",
      "type": "text",
      "x": 390,
      "y": 80,
      "width": 220,
      "height": 25,
      "text": "GREY-BOX MODEL (ml/grey_box.py)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq1",
      "type": "text",
      "x": 345,
      "y": 110,
      "width": 310,
      "height": 20,
      "text": "① ΔT_mesuré = T_heater − T_mold(t)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq2",
      "type": "text",
      "x": 345,
      "y": 135,
      "width": 310,
      "height": 20,
      "text": "② ΔT_normal = T_heater − T_mold_jour1",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq3",
      "type": "text",
      "x": 345,
      "y": 165,
      "width": 310,
      "height": 20,
      "text": "③ ΔT_calcaire = max(0, ΔT_mesuré − ΔT_normal)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq4",
      "type": "text",
      "x": 345,
      "y": 195,
      "width": 310,
      "height": 20,
      "text": "④ Q_moule = (débit/60/1000) × ρ × Cp × ΔT_mesuré",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq5",
      "type": "text",
      "x": 345,
      "y": 225,
      "width": 310,
      "height": 20,
      "text": "⑤ R_calcaire = ΔT_calcaire / Q_moule",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq6",
      "type": "text",
      "x": 345,
      "y": 255,
      "width": 310,
      "height": 20,
      "text": "⑥ e = R_calcaire × λ_calcaire × A × 1000  (mm)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq7",
      "type": "text",
      "x": 345,
      "y": 285,
      "width": 310,
      "height": 20,
      "text": "⑦ A = π × L × D  (surface latérale du tuyau)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq8",
      "type": "text",
      "x": 345,
      "y": 315,
      "width": 310,
      "height": 20,
      "text": "⑧ ΔT_max = (T_heater − T_critique) − ΔT_normal",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq9",
      "type": "text",
      "x": 345,
      "y": 345,
      "width": 310,
      "height": 20,
      "text": "⑨ Dégradation = min(ΔT_calcaire / ΔT_max × 100, 100) %",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "eq3_note",
      "type": "text",
      "x": 345,
      "y": 380,
      "width": 310,
      "height": 30,
      "text": "★ Équation clé : ΔT_calcaire isole la perte thermique\ndue au calcaire seul (ne dépend que des températures)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 90
    },
    {
      "id": "arrow_out",
      "type": "arrow",
      "x": 670,
      "y": 240,
